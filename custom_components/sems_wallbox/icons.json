{
    "entity": {
        "switch": {
            "start_charging": {
                "default": "mdi:ev-plug-type2"
            },
            "native_connection": {
                "default": "mdi:lan-connect",
                "state": {
                    "on": "mdi:lan-connect",
                    "off": "mdi:cloud-outline"
                }
            }
        },
        "number": {
            "charge_power": {
                "default": "mdi:speedometer"
            }
        },
        "select": {
            "charge_mode": {
                "default": "mdi:ev-station",
                "state": {
                    "fast": "mdi:lightning-bolt",
                    "pv_priority": "mdi:solar-power",
                    "pv_and_battery": "mdi:battery-charging"
                }
            }
        },
        "binary_sensor": {
            "charging_active": {
                "default": "mdi:ev-station",
                "state": {
                    "on": "mdi:battery-charging",
                    "off": "mdi:ev-plug-type2"
                }
            }
        },
        "sensor": {
            "status": {
                "default": "mdi:ev-station",
                "state": {
                    "charging": "mdi:battery-charging",
                    "standby": "mdi:ev-station",
                    "starting": "mdi:progress-clock",
                    "waiting": "mdi:clock-outline",
                    "offline": "mdi:power-plug-off",
                    "unknown": "mdi:help-circle-outline"
                }
            },
            "workstate": {
                "default": "mdi:ev-plug-type2",
                "state": {
                    "not_plugged_in": "mdi:power-plug-off-outline",
                    "connected": "mdi:power-plug",
                    "finished_charging": "mdi:battery-check"
                }
            },
            "set_charge_power_limit": {
                "default": "mdi:speedometer"
            },
            "native_fault": {
                "default": "mdi:alert-circle-outline"
            }
        }
    }
}
